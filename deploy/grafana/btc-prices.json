{
  "title": "Crypto Prices — BTCUSDT 1h",
  "uid": "btc-prices-1h",
  "tags": ["crypto-sync", "prices"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "1m",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "candlestick",
      "title": "BTCUSDT — Japanese Candlesticks (OHLC + Volume)",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 14 },
      "datasource": { "type": "mysql", "uid": "mariadb" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT FROM_UNIXTIME(close_time/1000) AS time, `open`, high, low, `close`, volume FROM ohlcv_btcusdt_1h WHERE close_time BETWEEN ${__from} AND ${__to} ORDER BY close_time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "fillOpacity": 50
          }
        }
      },
      "options": {
        "mode": "candles+volume",
        "candleStyle": "candles",
        "colorStrategy": "open-close",
        "colors": {
          "up": "green",
          "down": "red",
          "flat": "gray"
        },
        "fields": {},
        "includeAllFields": false,
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Total candles in DB",
      "gridPos": { "x": 0, "y": 14, "w": 6, "h": 4 },
      "datasource": { "type": "mysql", "uid": "mariadb" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*) AS total FROM ohlcv_btcusdt_1h"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Oldest candle",
      "gridPos": { "x": 6, "y": 14, "w": 9, "h": 4 },
      "datasource": { "type": "mysql", "uid": "mariadb" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT MIN(close_time) AS oldest FROM ohlcv_btcusdt_1h"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeAsIso",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "purple", "value": null }]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Newest candle",
      "gridPos": { "x": 15, "y": 14, "w": 9, "h": 4 },
      "datasource": { "type": "mysql", "uid": "mariadb" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT MAX(close_time) AS newest FROM ohlcv_btcusdt_1h"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeAsIso",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      }
    }
  ]
}
